# Copie este arquivo para .env e preencha. O .env nunca deve ir para o git.

# ---------------------------------------------------------------- Servidor
# Porta local. Em produção, remova API_PORT: a hospedagem define PORT sozinha
API_PORT=3001
# URL pública do servidor (usada para montar as URLs de webhook exibidas no painel)
# Produção: https://core.scalecompany.com.br
PUBLIC_URL=http://localhost:3001
# true = fontes sem credencial exibem dados de DEMONSTRAÇÃO (marcados no painel). Em produção: false
DEMO_MODE=true

# ---------------------------------------------------------------- Asaas (pagamento recorrente)
# Chave de API: Asaas > Integrações > Chaves de API
ASAAS_API_KEY=
# production | sandbox
ASAAS_ENV=production
# Token definido no cadastro do webhook no Asaas (header asaas-access-token)
ASAAS_WEBHOOK_TOKEN=

# ---------------------------------------------------------------- InfinitePay (cartão de crédito / Pix)
# InfiniteTag sem o "$"
INFINITEPAY_HANDLE=scalecompany_
# Confirma cada webhook recebido consultando /payment_check antes de aceitar (anti-fraude)
INFINITEPAY_VERIFY_WEBHOOK=true
# Segredo opcional na URL do webhook: /webhooks/infinitepay/<segredo>
INFINITEPAY_WEBHOOK_SECRET=
# Checkout: true = links simulados + botão de simular pagamento (testes). Em produção: false
INFINITEPAY_CHECKOUT_MOCK=false
# Opcional: token Bearer, só se a conta InfinitePay exigir autenticação para gerar links
INFINITEPAY_API_KEY=

# ---------------------------------------------------------------- Banco Inter (PJ)
# Portal Inter Empresas > Soluções para sua empresa > Nova integração (escopo extrato.read)
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_CERT_PATH=./certs/inter.crt
INTER_KEY_PATH=./certs/inter.key
# Na Vercel (sem disco): conteúdo dos arquivos em base64, no lugar dos caminhos acima
INTER_CERT_BASE64=
INTER_KEY_BASE64=
# Opcional, só se a integração tiver mais de uma conta
INTER_ACCOUNT=

# ---------------------------------------------------------------- Sicoob / Cresol
# Aguardando acesso. Os conectores aparecem como "aguardando acesso" no painel.
SICOOB_CLIENT_ID=
CRESOL_API_KEY=

# ---------------------------------------------------------------- Agente (OpenAI)
# Sem chave, o botão do assistente não aparece
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# low | medium | high
OPENAI_REASONING_EFFORT=medium

# ---------------------------------------------------------------- Colaboradores (webhook de outra plataforma)
# Segredo que vai no fim da URL: /webhooks/colaboradores/<segredo>. Gere um valor longo e aleatório.
COLLABORATORS_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Agente de e-mails (Gmail)
# OAuth do Google Cloud (Gmail API) – ver README, seção "Agente de e-mails"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chave que criptografa o token do Gmail guardado no banco (valor longo e aleatório; não mude depois de conectar)
GMAIL_TOKEN_KEY=
# Segredo da leitura agendada (a Vercel envia "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# ---------------------------------------------------------------- Banco de dados (Supabase) – obrigatório em produção
# Guarda vendas InfinitePay, cobranças/configuração do checkout, cache do Asaas e a versão do painel,
# tudo no schema "dashboard_financeiro" (ver supabase/migrations). Só o servidor usa a chave service_role.
# Também aceita NEXT_PUBLIC_SUPABASE_URL e NEXT_PUBLIC_SUPABASE_ANON_KEY (mesmo Supabase de outro projeto).
# O login do painel é o Supabase Auth: as contas são criadas no painel do Supabase (ver README).
# Vazio = arquivos locais em server/data (apenas desenvolvimento).
SUPABASE_URL=
# chave pública (anon): login com Supabase Auth e consultas do usuário sujeitas ao RLS
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=dashboard_financeiro
