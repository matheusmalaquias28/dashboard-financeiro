# Copie este arquivo para .env e preencha. O .env nunca deve ir para o git.

# ---------------------------------------------------------------- Servidor
# Porta local. Em produção, remova API_PORT: a hospedagem define PORT sozinha
API_PORT=3001
# URL pública do servidor (usada para montar as URLs de webhook exibidas no painel)
# Produção: https://core.scalecompany.com.br
PUBLIC_URL=http://localhost:3001
# Protege o dashboard com usuário/senha (recomendado em produção). Deixe vazio para desativar.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
# true = fontes sem credencial exibem dados de DEMONSTRAÇÃO (marcados no painel). Em produção: false
DEMO_MODE=true

# ---------------------------------------------------------------- Asaas (pagamento recorrente)
# Chave de API: Asaas > Integrações > Chaves de API
ASAAS_API_KEY=
# production | sandbox
ASAAS_ENV=production
# Token definido no cadastro do webhook no Asaas (header asaas-access-token)
ASAAS_WEBHOOK_TOKEN=

# ---------------------------------------------------------------- InfinitePay (cartão de crédito / Pix)
# InfiniteTag sem o "$"
INFINITEPAY_HANDLE=scalecompany_
# Confirma cada webhook recebido consultando /payment_check antes de aceitar (anti-fraude)
INFINITEPAY_VERIFY_WEBHOOK=true
# Segredo opcional na URL do webhook: /webhooks/infinitepay/<segredo>
INFINITEPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Banco Inter (PJ)
# Portal Inter Empresas > Soluções para sua empresa > Nova integração (escopo extrato.read)
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_CERT_PATH=./certs/inter.crt
INTER_KEY_PATH=./certs/inter.key
# Opcional, só se a integração tiver mais de uma conta
INTER_ACCOUNT=

# ---------------------------------------------------------------- Sicoob / Cresol
# Aguardando acesso. Os conectores aparecem como "aguardando acesso" no painel.
SICOOB_CLIENT_ID=
CRESOL_API_KEY=
